<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
<WebView android:id="@+id/webView" android:layout_width="match_parent" android:layout_height="match_parent" />
<FrameLayout android:id="@+id/inlinePlayerContainer" android:layout_width="1px" android:layout_height="1px" android:visibility="gone" android:elevation="12dp">
<androidx.media3.ui.PlayerView android:id="@+id/inlinePlayerView" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000" app:resize_mode="fit" app:show_buffering="when_playing" app:use_controller="true" />
<FrameLayout android:id="@+id/inlinePoster" android:layout_width="match_parent" android:layout_height="match_parent">
  <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/horrorstack_theater" android:scaleType="centerCrop" android:contentDescription="HorrorStack red movie theater" />
  <TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:background="#77000000" android:text="Starting movie…&#10;Enjoy the show" android:textSize="22sp" android:textColor="#FFFFFF" />
</FrameLayout>
</FrameLayout>
</FrameLayout>
